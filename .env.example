NODE_ENV=development

# URL interna de api/. Solo la usa el servidor de Next: el browser NUNCA la ve
# ni la llama. Por eso no lleva el prefijo NEXT_PUBLIC_ — si lo llevara, se
# filtraría al bundle del cliente y rompería el patrón BFF.
API_INTERNAL_URL=http://localhost:3001

# URL pública de web/, para armar links absolutos.
WEB_PUBLIC_URL=http://localhost:3000
